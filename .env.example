# Copy this file to .env and replace the placeholder values.
PORT=3500
DATABASE_URL=postgres://mypod:change-me@localhost:5432/mypod
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-value
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-value
# Websites allowed to call this API with cookies, separated by commas.
CORS_ORIGINS=http://localhost:5173,http://localhost:5500
# Folder that holds episode audio files.
AUDIO_DIR=audios
